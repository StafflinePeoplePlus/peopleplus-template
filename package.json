{
	"name": "peopleplus-template",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler pages dev --port 4173 --compatibility-date=2023-05-18 .svelte-kit/cloudflare/",
		"test": "playwright test",
		"test-coverage": "VITE_COVERAGE=true nyc --instrument=false playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test:unit-coverage": "vitest run --coverage",
		"lint": "prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --check . && eslint . && npm run check",
		"format": "prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --write .",
		"merge-coverage": "istanbul report -v --include='coverage/**/coverage-final.json' json-summary"
	},
	"devDependencies": {
		"@actions/github": "^6.0.0",
		"@cloudflare/workers-types": "^4.20250424.0",
		"@peopleplus/auth": "^0.0.0-snapshot-20250424110214",
		"@peopleplus/components": "^0.0.0-snapshot-20250424104414",
		"@playwright/test": "^1.52.0",
		"@sveltejs/adapter-cloudflare": "^4.1.0",
		"@sveltejs/kit": "^2.20.7",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@typescript-eslint/eslint-plugin": "^7.1.0",
		"@typescript-eslint/parser": "^7.1.0",
		"@vitest/coverage-istanbul": "^1.3.1",
		"autoprefixer": "^10.4.21",
		"dotenv": "^16.5.0",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.45.1",
		"istanbul": "^0.4.5",
		"istanbul-badges-readme": "^1.9.0",
		"jsdom": "^24.0.0",
		"kayle": "^0.8.64",
		"nyc": "^15.1.0",
		"playwright-test-coverage": "^1.2.12",
		"postcss": "^8.5.3",
		"postgres": "^3.4.5",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.1",
		"tslib": "^2.6.2",
		"typescript": "^5.8.3",
		"vite": "^5.4.4",
		"vite-plugin-istanbul": "^5.0.0",
		"vitest": "^1.3.1",
		"wrangler": "^3.25.0",
		"zod": "^3.24.3"
	},
	"type": "module"
}
